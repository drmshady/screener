# Frontend (Next.js) environment example — copy to `.env.local` for local dev and set
# the equivalents in Vercel for the hosted owner deployment. Never commit real secrets;
# `.env*` is gitignored (only this `.env.example` is tracked).

# ---------------------------------------------------------------------------
# Feature 013 — Portfolio import (Google Sheets read)
# ---------------------------------------------------------------------------
# PUBLIC OAuth client id (NOT a secret) for the browser-only Google Identity Services
# (GIS) token client. Reuses feature-010's Google Cloud OAuth app with the incremental
# `spreadsheets.readonly` scope; add the Vercel domain + http://localhost:3000 to the
# app's "Authorized JavaScript origins".
#
# Because `NEXT_PUBLIC_*` is inlined at build time, the import UI MUST degrade gracefully
# when this id (or the GIS script) is absent: the "Connect Google Sheet" button is shown
# disabled with an explanatory note, and no Google network call is attempted. This keeps
# the headless production-build e2e suite free of any Google or build-time-secret
# dependency (see plan.md "Deployment Compatibility" item 5).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Hosted mode (feature 010) — public flag, server-side gate + BFF proxy
# ---------------------------------------------------------------------------
# Public (build-time inlined) hosted-mode flag read by the browser bundle.
NEXT_PUBLIC_SCREENER_HOSTED_MODE=0
# Server-only mirror of the hosted-mode flag (route handlers / middleware).
SCREENER_HOSTED_MODE=0

# Single-owner allowlist + NextAuth (Auth.js) Google sign-in (server-only secrets).
SCREENER_OWNER_EMAIL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=

# Same-origin BFF proxy → FastAPI backend (server-only).
BACKEND_BASE_URL=http://localhost:8000
# Process-local owner secret injected by the BFF on every backend call (never sent to
# the browser; never written to any artifact file).
SCREENER_OWNER_SECRET=
